# Salin file ini menjadi .env:
#   cp .env.example .env
#
# .env dibaca otomatis oleh aplikasi (lihat internal/config/config.go) dan
# oleh `docker compose`. File .env tidak ikut di-commit.
# Environment proses tetap menang jika variabel yang sama diset dari luar.

# Lingkungan aplikasi: development | staging | production
APP_ENV=development

# Port HTTP server
PORT=8080

# Koneksi PostgreSQL (kredensial di bawah harus sama dengan service postgres)
DATABASE_URL=postgres://admin:admin@localhost:5432/simonjp?sslmode=disable

# Connection pool database (cocok untuk VPS 1 core / 1GB RAM)
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m

# --- Docker Compose (service lokal) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=simonjp
POSTGRES_PORT=5432

VALKEY_PASSWORD=admin
VALKEY_PORT=6379
